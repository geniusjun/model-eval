              },
              "finishReason": "stop"
            }
          }
        }
      },
      "script": [
        {
          "sse": {
            "chunks": [
              {
                "events": [
                  {
                    "data": {
                      "id": "chatcmpl-1",
                      "object": "chat.completion.chunk",
                      "created": 1,
                      "model": "model-b",
                      "choices": [
                        {
                          "index": 0,
                          "delta": {
                            "role": "assistant",
                            "content": "Hello there."
                          },
                          "finish_reason": "stop"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "bom": true
        }
      ],
      "expect": {
        "status": "ok",
        "raw": "",
        "final": "",
        "answers": 1,
        "finishReason": "stop",
        "warnings": [],
        "calls": [
          {
            "model": "model-b",
            "outcome": "unanswered",
            "errorKind": "transient"
          }
        ]
      }
    }
