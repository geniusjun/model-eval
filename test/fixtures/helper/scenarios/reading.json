      ],
      "apis": [
        "chat-completions"
      ],
      "service": {
        "behaviour": "flow-report",
        "params": {
          "steps": [
            {
              "call": {
                "name": "answer",
                "stream": true
              }
            }
          ],
          "report": {
            "result": {
              "raw": {
                "callText": "answer"
              },
              "finishReason": "stop"
            }
          }
        }
      },
      "script": [
        {
          "sse": {
            "chunks": [
              {
                "events": [
                  {
                    "data": {
                      "id": "chatcmpl-1",
                      "object": "chat.completion.chunk",
                      "created": 1,
                      "model": "model-b",
                      "choices": [
                        {
                          "index": 0,
                          "delta": {
                            "role": "assistant",
                            "content": "Hello there."
                          },
                          "finish_reason": "stop"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "bom": true
        }
      ],
      "expect": {
        "status": "ok",
