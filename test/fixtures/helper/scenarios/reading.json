  "S-ANS-18": [
    {
      "name": "n 2 on a stream of two choices, the service stopping after the first choice ended: the generation-end marker needs both choices, so a time-out",
      "apis": [
        "chat-completions"
      ],
      "service": {
        "behaviour": "flow-report",
        "params": {
          "steps": [
            {
              "call": {
                "name": "answer",
                "kwargs": {
                  "n": 2
                },
                "stream": true,
                "read": {
                  "events": 3
                }
              }
            }
          ],
          "report": {
            "result": {
              "raw": "First.",
              "finishReason": "stop"
            }
          }
        }
      },
      "script": [
        {
          "sse": {
            "chunks": [
              {
                "events": [
                  {
                    "data": {
                      "id": "chatcmpl-1",
                      "object": "chat.completion.chunk",
                      "created": 1,
                      "model": "model-b",
                      "choices": [
                        {
                          "index": 0,
                          "delta": {
                            "role": "assistant",
                            "content": "First."
                          },
                          "finish_reason": null
                        }
                      ]
                    }
                  },
                  {
                    "data": {
                      "id": "chatcmpl-1",
                      "object": "chat.completion.chunk",
                      "created": 1,
                      "model": "model-b",
                      "choices": [
                        {
                          "index": 0,
                          "delta": {},
                          "finish_reason": "stop"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "events": [
                  {
                    "data": {
                      "id": "chatcmpl-1",
                      "object": "chat.completion.chunk",
                      "created": 1,
                      "model": "model-b",
                      "choices": [
                        {
                          "index": 1,
                          "delta": {
                            "role": "assistant",
                            "content": "Sec"
                          },
                          "finish_reason": null
                        }
                      ]
                    }
                  }
                ],
                "delayMs": 50
              },
              {
                "events": [
                  {
                    "data": {
                      "id": "chatcmpl-1",
                      "object": "chat.completion.chunk",
                      "created": 1,
                      "model": "model-b",
                      "choices": [
                        {
                          "index": 1,
                          "delta": {
                            "content": "ond."
                          },
                          "finish_reason": null
                        }
                      ]
                    }
                  },
                  {
                    "data": {
                      "id": "chatcmpl-1",
                      "object": "chat.completion.chunk",
                      "created": 1,
                      "model": "model-b",
                      "choices": [
                        {
                          "index": 1,
                          "delta": {},
                          "finish_reason": "stop"
                        }
                      ]
                    }
                  },
                  {
                    "data": "[DONE]"
                  }
                ],
                "delayMs": 3000
              }
            ]
          }
        }
      ],
      "expect": {
        "status": "failed",
        "errorKind": "timeout"
      }
    },
