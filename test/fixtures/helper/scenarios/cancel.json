    {
      "name": "after the function returned, while the helper waits for an unfinished call: the response at once, timeout, the unfinished call joined as unanswered without errorKind or usage, so charged the call reservation",
      "service": {
        "behaviour": "flow",
        "params": {
          "steps": [
            {
              "call": {
                "name": "answer"
              }
            },
            {
              "background": {
                "user": "Slow note."
              }
            },
            {
              "sleepMs": 200
            }
          ],
          "result": {
            "callText": "answer"
          }
        }
      },
      "script": [
        {
          "match": {
            "bodyIncludes": "Say hello."
          },
          "reply": {
            "text": "Hello.",
            "usage": {
              "input": 12,
              "output": 6
            }
          }
        },
        {
          "match": {
            "bodyIncludes": "Slow note."
          },
          "delayMs": 8000,
          "reply": {
            "text": "Noted."
          }
        }
      ],
      "cancel": {
        "afterMs": 3000,
        "respondWithinMs": 1500
      },
      "expect": {
        "status": "failed",
        "errorKind": "timeout",
        "calls": [
          {
            "model": "model-b",
            "outcome": "ok",
            "usage": {
              "input": 12,
              "output": 6
            }
          },
          {
            "model": "model-b",
            "outcome": "unanswered",
            "errorKind": null,
            "usage": null
          }
        ],
        "notifications": []
      }
    },
    {
