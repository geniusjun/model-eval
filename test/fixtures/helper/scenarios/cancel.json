  "S-COST-09": [
    {
      "name": "a request the SDK resends after waiting is not sent and not recorded",
      "service": {
        "behaviour": "reply",
        "params": {
          "maxRetries": 1
        }
      },
      "script": [
        {
          "status": 429,
          "headers": {
            "retry-after-ms": "1500"
          },
          "error": {
            "message": "slow down"
          }
        },
        {
          "reply": {
            "text": "Never sent."
          }
        }
      ],
      "cancel": {
        "afterStderr": "retrying"
      },
      "expect": {
        "calls": [
          {
            "model": "model-b",
            "outcome": "failed",
            "errorKind": "transient"
          }
        ],
        "notifications": [],
        "requests": [
          {
            "model": "model-b"
          }
        ]
      }
    }
  ]
}
