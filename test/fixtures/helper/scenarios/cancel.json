            {
              "sleepMs": 200
            }
          ],
          "result": {
            "callText": "answer"
          }
        }
      },
      "script": [
        {
          "match": {
            "bodyIncludes": "Check the key."
          },
          "status": 401,
          "error": {
            "message": "invalid key"
          }
        },
        {
          "match": {
            "bodyIncludes": "Say hello."
          },
          "reply": {
            "text": "Hello.",
            "usage": {
              "input": 12,
              "output": 6
            }
          }
        },
        {
          "match": {
            "bodyIncludes": "Slow note."
          },
          "delayMs": 8000,
          "reply": {
            "text": "Noted."
          }
        }
      ],
      "cancel": {
        "afterMs": 3000,
        "respondWithinMs": 1500
      },
      "expect": {
        "status": "failed",
        "errorKind": "config",
        "calls": [
          {
            "model": "model-b",
            "outcome": "failed",
            "errorKind": "config"
          },
          {
            "model": "model-b",
            "outcome": "ok",
            "usage": {
              "input": 12,
              "output": 6
            }
          },
          {
            "model": "model-b",
            "outcome": "unanswered",
            "errorKind": null,
            "usage": null
          }
        ],
        "notifications": []
      }
    }
