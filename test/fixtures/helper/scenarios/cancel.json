{
  "S-RESP-11": [
    {
      "name": "an asynchronous target: the call in flight is cut, unanswered and not classified",
      "backends": [
        "async",
        "aiohttp"
      ],
      "service": {
        "behaviour": "reply"
      },
      "script": [
        {
          "delayMs": 5000,
          "reply": {
            "text": "Too late."
          }
        }
      ],
      "cancel": {
        "afterRequests": 1
      },
      "expect": {
        "calls": [
          {
            "model": "model-b",
            "outcome": "unanswered",
            "errorKind": null
          }
        ],
        "notifications": [],
        "requests": [
          {
            "model": "model-b"
          }
        ],
        "status": "failed",
        "errorKind": "timeout"
      }
    },
    {
      "name": "a synchronous target: the request in flight completes and is recorded as it ended; the later request is not sent and not recorded",
      "backends": [
        "sync"
      ],
      "service": {
        "behaviour": "steps",
        "params": {
          "steps": [
            {
              "call": {}
            },
            {
              "call": {
                "user": "A request after the cancel."
              },
              "swallow": true
            }
          ]
        }
      },
      "script": [
        {
          "delayMs": 1500,
          "reply": {
            "text": "In flight.",
            "usage": {
              "input": 12,
              "output": 6
            }
          }
        },
        {
          "reply": {
            "text": "Never sent."
          }
        }
      ],
      "cancel": {
        "afterRequests": 1
      },
      "expect": {
        "calls": [
          {
            "model": "model-b",
            "outcome": "ok",
            "errorKind": null,
            "usage": {
              "input": 12,
              "output": 6
            }
          }
        ],
        "notifications": [],
        "requests": [
          {
            "model": "model-b"
          }
        ],
        "status": "failed",
        "errorKind": "timeout"
      }
    },
    {
      "name": "an asynchronous target after a captured 401: config with that call's failure, the call in flight cut",
      "backends": [
        "async",
        "aiohttp"
      ],
      "service": {
        "behaviour": "steps",
        "params": {
          "steps": [
            {
              "call": {
                "user": "Check the key."
              },
              "swallow": true
            },
            {
              "call": {}
            }
          ]
        }
      },
      "script": [
        {
          "match": {
            "bodyIncludes": "Check the key."
          },
          "status": 401,
          "error": {
            "message": "invalid key"
          }
        },
        {
          "delayMs": 5000,
          "reply": {
            "text": "Too late."
          }
        }
      ],
      "cancel": {
        "afterRequests": 2
      },
      "expect": {
        "status": "failed",
        "errorKind": "config",
        "calls": [
          {
            "model": "model-b",
            "outcome": "failed",
            "errorKind": "config"
          },
          {
            "model": "model-b",
            "outcome": "unanswered",
            "errorKind": null
          }
        ],
        "notifications": []
      }
    },
    {
      "name": "a synchronous target after a captured 401: config, the request in flight recorded as it ended",
      "backends": [
        "sync"
      ],
      "service": {
        "behaviour": "steps",
        "params": {
          "steps": [
            {
              "call": {
                "user": "Check the key."
              },
              "swallow": true
            },
            {
              "call": {}
            }
          ]
        }
      },
      "script": [
        {
          "match": {
            "bodyIncludes": "Check the key."
          },
          "status": 401,
          "error": {
            "message": "invalid key"
          }
        },
        {
          "delayMs": 1500,
          "reply": {
            "text": "In flight."
          }
        }
      ],
      "cancel": {
        "afterRequests": 2
      },
      "expect": {
        "status": "failed",
