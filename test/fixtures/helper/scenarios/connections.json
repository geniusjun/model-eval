    {
      "name": "connection-pool wait time-out while another call holds the only connection: transient, failed",
      "backends": [
        "async"
      ],
      "service": {
        "behaviour": "flow",
        "params": {
          "steps": [
            {
              "parallel": [
                {
                  "model": "model-x",
                  "user": "Hold the connection."
                },
                {
                  "poolTimeoutMs": 200,
                  "startAfterMs": 300
                }
              ]
            }
          ],
          "sharedClient": {
            "maxConnections": 1
          }
        }
      },
      "script": [
        {
          "match": {
            "model": "model-x"
          },
          "delayMs": 1500,
          "reply": {
            "text": "Held."
          }
        }
      ],
      "expect": {
        "status": "failed",
        "errorKind": "transient",
        "calls": [
          {
            "model": "model-x",
            "outcome": "ok",
            "branch": "side"
          },
          {
            "model": "model-b",
            "outcome": "failed",
            "branch": "answer",
            "errorKind": "transient"
          }
        ]
      }
    },
    {
      "name": "request body write failure: the server closes without reading a large body; the transport reports it as a drop before the headers, so transient, unanswered (Known Limit)",
      "service": {
        "behaviour": "flow",
        "params": {
          "steps": [
            {
              "call": {
                "userBytes": 16000000
              }
            }
          ]
        }
      },
      "script": [
        {
          "connection": "close-unread"
        }
      ],
      "expect": {
        "status": "failed",
        "errorKind": "transient",
        "calls": [
          {
            "model": "model-b",
            "outcome": "unanswered",
            "branch": "answer",
            "errorKind": "transient"
          }
        ]
      }
    }
  ],
