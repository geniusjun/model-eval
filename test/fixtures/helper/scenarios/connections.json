  "S-CONN-13": [
    {
      "name": "a drop after a Responses error event: the call failed by the event, the drop is no failure",
      "apis": [
        "responses"
      ],
      "service": {
        "behaviour": "flow",
        "params": {
          "steps": [
            {
              "call": {
                "stream": true
              }
            }
          ]
        }
      },
      "script": [
        {
          "sse": {
            "chunks": [
              {
                "events": [
                  {
                    "event": "response.created",
                    "data": {
                      "type": "response.created",
                      "sequence_number": 0,
                      "response": {
                        "id": "resp_drop",
                        "object": "response",
                        "created_at": 0,
                        "status": "in_progress",
                        "model": "model-b",
                        "output": []
                      }
                    }
                  }
                ]
              },
              {
                "events": [
                  {
                    "event": "error",
                    "data": {
                      "type": "error",
                      "sequence_number": 1,
                      "code": "server_error",
                      "message": "The server had an error.",
                      "param": null
                    }
                  }
                ]
              },
              {
                "text": "event: response.output_text.delta\n"
              }
            ]
          },
          "drop": {
            "chunks": 2,
            "bytes": 10
          }
        }
      ],
      "expect": {
        "status": "failed",
        "errorKind": "transient",
        "calls": [
          {
            "model": "model-b",
            "outcome": "unanswered",
            "branch": "answer",
            "errorKind": "transient"
          }
        ]
      }
    }
  ],
