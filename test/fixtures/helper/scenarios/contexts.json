        {
          "reply": {
            "text": "Here is the answer."
          }
        }
      ],
      "expect": {
        "status": "ok",
        "finalKind": "model",
        "raw": "Here is the answer.",
        "final": "Here is the answer.",
        "answers": 1,
        "calls": [
          {
            "model": "model-b",
            "outcome": "ok",
            "branch": "answer"
          }
        ]
      }
    },
