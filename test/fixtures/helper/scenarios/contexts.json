    {
      "name": "two trials in progress: a request from a thread without the context ends every trial as A10",
      "service": {
        "behaviour": "flow",
        "params": {
          "steps": [
            {
              "sleepMs": 300
            },
            {
              "thread": {
                "name": "answer"
              },
              "context": "none"
            },
            {
              "sleepMs": 300
            }
          ],
          "result": {
            "text": "Here is the answer."
          }
        }
      },
      "adapter": {
        "maxConcurrency": 2
      },
      "trials": 2,
      "script": [
        {
          "reply": {
            "text": "Here is the answer."
          },
          "times": 2
        }
      ],
      "expect": {
        "status": "adapter-error",
        "adapterError": {
          "message": "A10"
        }
      }
    }
  ],
  "S-CTX-02": [
    {
      "name": "at concurrency 1, the previous trial's background thread request joins the next trial after its failure: the first trial Outcome row 3, transient; the second Outcome row 4 (K26)",
      "service": {
        "behaviour": "flow",
        "params": {
          "steps": [
            {
              "call": {
                "model": "model-x",
                "system": "Safety check: answer allow or block.",
                "onError": "swallow"
              }
            },
            {
              "thread": {
                "model": "model-y",
                "system": "Record the analytics event.",
                "user": "hello",
                "startAfterMs": 1500
              },
              "context": "none",
              "join": false
            },
            {
              "sleepMs": 1000
            }
          ],
          "result": {
            "text": "Sorry, I cannot answer right now."
          }
        }
      },
      "trialsInARow": 2,
      "script": [
        {
          "error": {
            "status": 429
          }
        },
        {
          "error": {
            "status": 429
          }
        },
        {
          "match": {
            "model": "model-y"
          },
          "times": 2,
          "reply": {
            "text": "Logged."
          }
        }
      ],
      "expectPerTrial": [
        {
          "status": "failed",
          "errorKind": "transient",
          "calls": [
            {
              "model": "model-x",
              "outcome": "failed",
              "branch": null,
              "errorKind": "transient"
            }
          ]
        },
        {
          "status": "adapter-error",
          "adapterError": {
            "message": "A2",
            "placeholders": {
              "model": "model-b",
              "models": "`model-x`, `model-y`"
            }
          },
          "calls": [
            {
              "model": "model-x",
              "outcome": "failed",
              "branch": null,
              "errorKind": "transient"
            },
            {
              "model": "model-y",
              "outcome": "ok",
              "branch": null
            }
          ]
        }
      ]
    }
  ],
