{
  "S-RESP-01": [
    {
      "name": "Chat Completions: one answer call, its text shipped unchanged",
      "apis": [
        "chat-completions"
      ],
      "service": {
        "behaviour": "reply"
      },
      "params": {
        "input": {
          "user": "Say hello."
        }
      },
      "script": [
        {
          "reply": {
            "text": "Hello from the mock server.",
            "usage": {
              "input": 12,
              "output": 6
            }
          }
        }
      ],
      "expect": {
        "status": "ok",
        "finalKind": "model",
        "raw": "Hello from the mock server.",
        "final": "Hello from the mock server.",
        "answers": 1,
        "finishReason": "stop",
        "calls": [
          {
            "model": "model-b",
            "outcome": "ok",
            "branch": "answer",
            "usage": {
              "input": 12,
              "output": 6
            }
          }
        ],
        "requests": [
          {
            "method": "POST",
            "api": "chat-completions",
            "model": "model-b",
            "stream": false
          }
        ]
      }
    },
