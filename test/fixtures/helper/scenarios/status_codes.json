  "S-STAT-08": [
    {
      "name": "thread_not_found, the whole conversation resent, reply_call true for both: normal",
      "apis": [
        "messages"
      ],
      "target": {
        "replyCall": true
      },
      "service": {
        "behaviour": "flow",
        "params": {
          "steps": [
            {
              "call": {
                "name": "thread",
                "user": "Continue.",
                "kwargs": {
                  "extra_body": {
                    "thread": {
                      "id": "thread_mock_1"
                    }
                  }
                },
                "onError": "swallow"
              }
            },
            {
              "call": {
                "name": "whole",
                "user": "Continue.",
                "kwargs": {
                  "messages": [
                    {
                      "role": "user",
                      "content": "Earlier question."
                    },
                    {
                      "role": "assistant",
                      "content": "Earlier answer."
                    },
                    {
                      "role": "user",
                      "content": "Continue."
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "script": [
        {
          "error": {
            "status": 404,
            "code": "thread_not_found"
          }
        },
        {
          "reply": {
            "text": "Continued."
          }
        }
      ],
      "expect": {
        "status": "ok",
        "finalKind": "model",
        "raw": "Continued.",
        "final": "Continued.",
        "answers": 1,
        "calls": [
          {
            "model": "model-b",
            "outcome": "failed",
            "branch": "answer",
            "errorKind": "permanent"
          },
          {
            "model": "model-b",
            "outcome": "ok",
            "branch": "answer"
          }
        ]
      }
    },
