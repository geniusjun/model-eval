        "usage": {
          "input": 25,
          "output": 7
        },
        "calls": [
          {
            "model": "model-b",
            "outcome": "ok",
            "usage": {
              "input": 5,
              "output": 1
            }
          },
          {
            "model": "model-b",
            "outcome": "ok",
            "usage": {
              "input": 20,
              "output": 6
            }
          }
        ]
      }
