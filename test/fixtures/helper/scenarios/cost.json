{
  "S-COST-01": [
    {
      "name": "a call outside the captured transports with Result(raw=, finish_reason=, usage=, model=): no calls, priced from usage",
      "service": {
        "behaviour": "flow-report",
        "params": {
          "steps": [
            {
              "uncaptured": {
                "name": "answer"
              }
            }
          ],
          "report": {
            "result": {
              "raw": {
                "callText": "answer"
              },
              "final": {
                "callText": "answer"
              },
              "finishReason": "stop",
              "usage": {
                "input": 20,
                "output": 6
              },
              "model": "model-b"
            }
          }
        }
      },
      "script": [
        {
          "reply": {
            "text": "Here is the answer."
          }
        }
      ],
      "expect": {
        "status": "ok",
        "finalKind": "model",
        "raw": "Here is the answer.",
        "usage": {
          "input": 20,
          "output": 6
        },
        "calls": null
      }
    }
  ],
