  "S-COST-06": [
    {
      "name": "a Responses background response (first request queued) with Result(raw=, finish_reason=, usage=): the first request's usage, not counted twice",
      "apis": [
        "responses"
      ],
      "service": {
        "behaviour": "flow-report",
        "params": {
          "steps": [
            {
              "call": {
                "kwargs": {
                  "background": true
                }
              }
            },
            {
              "http": {
                "method": "GET",
                "path": "/responses/resp-background",
                "status": 200
              }
            }
          ],
          "report": {
            "result": {
              "raw": "Here is the answer.",
              "final": "Here is the answer.",
              "finishReason": "stop",
              "usage": {
                "input": 20,
                "output": 6
              }
            }
          }
        }
      },
      "script": [
        {
          "match": {
            "method": "POST"
          },
          "reply": {
            "status": "queued"
          }
        },
        {
          "match": {
            "method": "GET"
          },
          "body": {
            "id": "resp-background",
            "object": "response",
            "status": "completed"
          }
        }
      ],
      "expect": {
        "status": "ok",
        "raw": "Here is the answer.",
        "usage": {
          "input": 20,
          "output": 6
        },
        "calls": [
          {
            "model": "model-b",
            "outcome": "ok",
            "usage": {
              "input": 20,
              "output": 6
            }
          }
        ]
      }
    }
  ],
