  "S-COST-04": [
    {
      "name": "the answer outside the captured transports, only another model's side call captured: Result(usage=) is added to calls as the uncaptured call",
      "service": {
        "behaviour": "flow-report",
        "params": {
          "steps": [
            {
              "call": {
                "model": "model-x",
                "system": "Classify the message."
              }
            },
            {
              "uncaptured": {
                "name": "answer"
              }
            }
          ],
          "report": {
            "result": {
              "raw": {
                "callText": "answer"
              },
              "final": {
                "callText": "answer"
              },
              "finishReason": "stop",
              "usage": {
                "input": 20,
                "output": 6
              },
              "model": "model-b"
            }
          }
        }
      },
      "script": [
        {
          "match": {
            "bodyIncludes": "Classify"
          },
          "reply": {
            "text": "chat",
            "usage": {
              "input": 5,
              "output": 1
            }
          }
        },
        {
          "match": {
            "bodyIncludes": "helpful assistant"
          },
          "reply": {
            "text": "Here is the answer."
          }
        }
      ],
      "expect": {
        "status": "ok",
        "raw": "Here is the answer.",
        "usage": {
          "input": 25,
          "output": 7
        },
        "warnings": [],
        "calls": [
          {
            "model": "model-x",
            "outcome": "ok",
            "usage": {
              "input": 5,
              "output": 1
            }
          },
          {
            "model": "model-b",
            "outcome": "ok",
            "usage": {
              "input": 20,
              "output": 6
            }
          }
        ]
      }
    },
