{
  "name": "model-eval",
  "version": "0.1.0",
  "description": "Checks whether an LLM service's prompt rules and post-processing still hold when it moves to another model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geniusjun/model-eval.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "model-eval": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/helper/index.d.ts",
      "default": "./dist/helper/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "adapters/python/model_eval_adapter.py"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config viewer/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p viewer/tsconfig.json && tsc -p viewer/tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm build && vitest run --project unit --project contract --project e2e --project viewer",
    "test:contract": "pnpm build && sh -c '[ \"$1\" = -- ] && shift; exec vitest run --project contract \"$@\"' test:contract",
    "test:parity": "pnpm build && vitest run --project contract test/contract/helper/parity.test.ts",
    "test:example": "pnpm build && vitest run --project example",
    "test:browser": "playwright test",
    "schemas": "tsx scripts/generate-schemas.ts",
    "format:check": "prettier --check .",
    "check:coverage": "tsx scripts/check-spec-coverage.ts",
    "bench": "tsx bench/sc003.ts",
    "bench:overhead": "pnpm build && tsx bench/overhead.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "anthropic-sdk-0": "npm:@anthropic-ai/sdk@0.137.0",
    "anthropic-sdk-0-first": "npm:@anthropic-ai/sdk@0.50.1",
    "anthropic-sdk-1": "npm:@anthropic-ai/sdk@1.8.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-dom": "^5.30.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "openai-5": "npm:openai@5.23.2",
    "openai-5-first": "npm:openai@5.0.0",
    "openai-6": "npm:openai@6.49.0",
    "openai-7": "npm:openai@7.55.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
