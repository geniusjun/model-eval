{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model-eval adapter protocol v1",
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "InitializeParams": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "variant": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "params": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              }
            }
          },
          "required": [
            "id",
            "model"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "toolPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "protocolVersion",
        "client",
        "variant",
        "timeoutMs",
        "toolPaths"
      ]
    },
    "Service": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        },
        "treeHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "render": {
          "default": false,
          "type": "boolean"
        },
        "stages": {
          "default": false,
          "type": "boolean"
        },
        "postprocess": {
          "default": true,
          "type": "boolean"
        },
        "cancel": {
          "default": false,
          "type": "boolean"
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "InitializeResult": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "helper": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "language",
                "version"
              ]
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "service": {
          "$ref": "#/$defs/Service"
        },
        "targets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "inputSchema": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/JsonValue"
                    }
                  }
                ]
              }
            },
            "required": [
              "name",
              "inputSchema"
            ]
          }
        },
        "capabilities": {
          "default": {},
          "$ref": "#/$defs/Capabilities"
        }
      },
      "required": [
        "protocolVersion",
        "adapter",
        "targets"
      ]
    },
    "RenderParams": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "repeat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "target",
        "input"
      ]
    },
    "RenderResult": {
      "type": "object",
      "properties": {
        "messages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "content"
            ]
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "messages"
      ]
    },
    "GenerateParams": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "repeat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "target",
        "input",
        "caseId",
        "repeat",
        "seed"
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cachedInput": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheWrite": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "CallRecord": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ok",
            "failed",
            "unanswered"
          ]
        },
        "responseModel": {
          "type": "string",
          "minLength": 1
        },
        "errorKind": {
          "type": "string",
          "enum": [
            "config",
            "transient",
            "permanent",
            "timeout"
          ]
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "branch": {
          "type": "string",
          "enum": [
            "answer",
            "side"
          ]
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "finishReason": {
          "type": "string"
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "model",
        "outcome"
      ]
    },
    "GenerateResult": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "usage": {
              "$ref": "#/$defs/Usage"
            },
            "calls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CallRecord"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "error": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "config",
                    "transient",
                    "permanent",
                    "timeout"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "retryAfterMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "message"
              ]
            },
            "latencyMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "usage": {
                  "$ref": "#/$defs/Usage"
                },
                "calls": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/CallRecord"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "raw": {
                  "type": "string"
                },
                "answers": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "stages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "text"
                    ]
                  }
                },
                "latencyMs": {
                  "type": "number",
                  "minimum": 0
                },
                "finishReason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "content_filter",
                    "other"
                  ]
                },
                "modelSnapshot": {
                  "type": "string",
                  "minLength": 1
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "finalKind": {
                  "type": "string",
                  "const": "model"
                },
                "final": {
                  "type": "string"
                }
              },
              "required": [
                "raw",
                "latencyMs",
                "finishReason",
                "finalKind",
                "final"
              ]
            },
            {
              "type": "object",
              "properties": {
                "usage": {
                  "$ref": "#/$defs/Usage"
                },
                "calls": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/CallRecord"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "raw": {
                  "type": "string"
                },
                "answers": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "stages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "text"
                    ]
                  }
                },
                "latencyMs": {
                  "type": "number",
                  "minimum": 0
                },
                "finishReason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "content_filter",
                    "other"
                  ]
                },
                "modelSnapshot": {
                  "type": "string",
                  "minLength": 1
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "finalKind": {
                  "type": "string",
                  "const": "fallback"
                },
                "final": {
                  "type": "string"
                }
              },
              "required": [
                "raw",
                "latencyMs",
                "finishReason",
                "finalKind",
                "final"
              ]
            },
            {
              "type": "object",
              "properties": {
                "usage": {
                  "$ref": "#/$defs/Usage"
                },
                "calls": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/CallRecord"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "raw": {
                  "type": "string"
                },
                "answers": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "stages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "text"
                    ]
                  }
                },
                "latencyMs": {
                  "type": "number",
                  "minimum": 0
                },
                "finishReason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "content_filter",
                    "other"
                  ]
                },
                "modelSnapshot": {
                  "type": "string",
                  "minLength": 1
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "finalKind": {
                  "type": "string",
                  "const": "discarded"
                },
                "discardReason": {
                  "type": "string"
                }
              },
              "required": [
                "raw",
                "latencyMs",
                "finishReason",
                "finalKind"
              ]
            }
          ]
        }
      ]
    },
    "RpcErrorData": {
      "type": "object",
      "properties": {
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallRecord"
          }
        },
        "capturedRaw": {
          "type": "string"
        }
      }
    },
    "ShutdownResult": {
      "type": "null"
    },
    "CancelParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id"
      ]
    },
    "CallsParams": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallRecord"
          }
        }
      },
      "required": [
        "calls"
      ]
    },
    "LogParams": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "message"
      ]
    },
    "AdapterMessage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "$ref": "#/$defs/JsonValue"
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "result": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "params": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/JsonValue"
                  }
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/JsonValue"
                  }
                }
              ]
            }
          },
          "required": [
            "jsonrpc",
            "method"
          ]
        }
      ]
    }
  }
}
